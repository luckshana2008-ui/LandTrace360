# LandTrace360 Express Server Configuration
PORT=5000

# Google AI Studio Gemini API Key
# Obtain free from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Open Government Data (data.gov.in) Platform API Key (Optional for live sync)
# Obtain from: https://data.gov.in/user/register
DATA_GOV_IN_API_KEY=

# JWT Secret for Session Authentication
JWT_SECRET=landtrace360-jwt-secret-key-coimbatore-2026
